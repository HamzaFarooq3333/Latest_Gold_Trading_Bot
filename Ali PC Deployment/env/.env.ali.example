# =============================================================================
# Ali PC -> GCP live desk bridge.   Copy to: C:\onyxion-ali\.env
# NEVER commit the real .env (it holds the MT5 password).
#
# This file is the source of truth for the live configuration. The desk's
# "Live controls" only override it when someone presses Save on the dashboard.
# =============================================================================

# --- Exness DEMO trading account (not the investor password) ---
ASIM_MT5_LOGIN=472640728
ASIM_MT5_PASSWORD=CHANGE_ME
ASIM_MT5_SERVER=Exness-MT5Trial16

# --- portable MT5 on THIS PC ---
ASIM_MT5_SYMBOL=XAUUSDm
ASIM_MT5_TERMINAL_PATH=C:\onyxion-ali\exness-mt5\terminal64.exe
ASIM_MT5_PORTABLE=1

# --- GCP live desk (IP changes if the VM is restarted) ---
ASIM_LAB_URL=https://35.253.21.246
ASIM_LAB_INSECURE=1

# --- GitOps: the update agent pulls this clone (candle-safe apply) ---
BRIDGE_UPDATE_GIT=C:\onyxion-src\Latest_Gold_Trading_Bot
BRIDGE_UPDATE_GIT_REMOTE=https://github.com/HamzaFarooq3333/Latest_Gold_Trading_Bot.git
BRIDGE_PROFILE=ali

# --- sanity check (must match ASIM_MT5_LOGIN) ---
EXPECTED_MT5_LOGIN=472640728
EXPECTED_MT5_SYMBOL=XAUUSDm

# --- X-Trend = KJ GagaTrend on Heikin-Ashi (Hamza's desk uses supertrend) ---
XTREND_SOURCE=gaga
XTREND_GATE=1
XTREND_BUF=0
XTREND_GATE_SUPP=0

# --- hour / weekend filters stay OFF for Ali ---
SKIP_WORST_HOURS=0
FOCUS_BEST_HOURS=0
SKIP_WEEKENDS=0

# --- strategy selected by walk-forward test (Feb-May optimise, Jun-Aug validate) ---
# Primary gate (previous-body break AND whole candle clear of X-Trend) on
# EVERY green/red candle; each pass opens a ticket, stacking to MAXPOS.
# No supplementary wick logic (MAX_SUPP=0). Amber still flattens.
VOLUME=0.02
ENTRY_EVERY_CANDLE=1
HIST_THRESH=10
HIST_THRESH_SUPP=18
MAXPOS=20
MAX_SUPP=0

# --- trailing stop: 1.25 x Wilder ATR(14) of raw M15 at entry, fixed per trade;
#     trails each bar CLOSE. TSL_TICKS is the fallback when TSL_ATR_MULT=0 ---
TSL_ATR_MULT=1.25
TSL_TICKS=1111
TSL_TICK_SIZE=0.001
TRAIL_EVERY_CANDLE=1
TRAIL_ENTRY_BAR=1
ENTRY_BAR_MODE=defer
DISABLE_STOP_LOSS=0
STOP_SLIPPAGE_PTS=0
# TSL_PTS only shapes the gap-open fill of a primary; it is not a stop.
TSL_PTS=1
# broker-side minimum stop distance (price units) applied to the submitted SL only
BROKER_MIN_STOP_PTS=0.30

# --- paper account model used by the engine's margin gate ---
SPREAD_COST=0.06
LEVERAGE=100
START_BALANCE=500
BEST_LOT_MULT=2.0

MT5_POLL_SECONDS=2
MT5_MAGIC_ASIM=126823
