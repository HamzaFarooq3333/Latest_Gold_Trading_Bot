# =============================================================================
# Ali PC → GCP live desk bridge
# Copy this file to: C:\onyxion-ali\.env
# NEVER commit the real .env with passwords to git / chat logs.
# =============================================================================

# --- REQUIRED: Exness DEMO trading account (not investor password) ---
ASIM_MT5_LOGIN=472640728
ASIM_MT5_PASSWORD=CHANGE_ME_DEMO_TRADING_PASSWORD
ASIM_MT5_SERVER=Exness-MT5Trial16

# --- REQUIRED: portable MT5 path on THIS PC ---
ASIM_MT5_SYMBOL=XAUUSDm
ASIM_MT5_TERMINAL_PATH=C:\onyxion-ali\exness-mt5\terminal64.exe
ASIM_MT5_PORTABLE=1

# --- REQUIRED: auto-update from Latest GitHub (preferred) or desk ZIP ---
# Source of truth: https://github.com/HamzaFarooq3333/Latest_Gold_Trading_Bot
BRIDGE_UPDATE_GIT=C:\onyxion-src\Latest_Gold_Trading_Bot
BRIDGE_UPDATE_GIT_REMOTE=https://github.com/HamzaFarooq3333/Latest_Gold_Trading_Bot.git
# ZIP fallback (optional if GIT clone is present):
BRIDGE_UPDATE_URL=https://35.253.21.246/bridge/onyxion-bridge-bundle.zip
BRIDGE_PROFILE=ali
ASIM_LAB_URL=https://35.253.21.246
ASIM_LAB_INSECURE=1

# --- Sanity check (must match ASIM_MT5_LOGIN) ---
EXPECTED_MT5_LOGIN=472640728
EXPECTED_MT5_SYMBOL=XAUUSDm

# --- Ali X-Trend source = KJ GagaTrend (Hamza used SuperTrend; do NOT change for Ali) ---
XTREND_SOURCE=gaga
XTREND_GATE=1
XTREND_BUF=0
# SUPP X-Trend gate is separate (default OFF = wick break of last trade candle only)
XTREND_GATE_SUPP=0

# --- Live filters (match GCP desk) — MUST stay OFF for Ali ---
SKIP_WORST_HOURS=0
FOCUS_BEST_HOURS=0
SKIP_WEEKENDS=0

# Bridge stamps every heartbeat with UTC bar/tick/server times (time_tz=UTC)
# so MT5 M15 bar opens and the live dashboard chart axis stay aligned.

# --- Engine tuning (match Google Console Deployment/env.instance-20260831-171822) ---
VOLUME=0.01
HIST_THRESH=10
TSL_PTS=11.02
STOP_SLIPPAGE_PTS=0
SPREAD_COST=0.06
TRAIL_EVERY_CANDLE=1
# Trail stop to entry-bar close (ON). Defer still skips stop-TEST on entry bar.
# OFF reproduces the uniform -0.56 stop-outs — leave ON unless A/B testing.
TRAIL_ENTRY_BAR=1
DISABLE_STOP_LOSS=0
ENTRY_BAR_MODE=defer
PRIMARY_WICK_GATE=0
MAXPOS=20
MAX_SUPP=10
LEVERAGE=100
BEST_LOT_MULT=2.0
START_BALANCE=500

# Optional:
# MT5_POLL_SECONDS=2
# MT5_MAGIC_ASIM=126823
# ASIM_MT5_LOT=0.01
