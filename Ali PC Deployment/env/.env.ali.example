# =============================================================================
# Ali PC → GCP live desk bridge
# Copy this file to: C:\onyxion-ali\.env
# NEVER commit the real .env with passwords to git / chat logs.
# =============================================================================

# --- REQUIRED: Exness DEMO trading account (not investor password) ---
ASIM_MT5_LOGIN=472640728
ASIM_MT5_PASSWORD=CHANGE_ME_DEMO_TRADING_PASSWORD
ASIM_MT5_SERVER=Exness-MT5Trial16

# --- REQUIRED: portable MT5 path on THIS PC ---
ASIM_MT5_SYMBOL=XAUUSDm
ASIM_MT5_TERMINAL_PATH=C:\onyxion-ali\exness-mt5\terminal64.exe
ASIM_MT5_PORTABLE=1

# --- REQUIRED: Ali GCP live desk (IP changes if VM is restarted — update both URLs) ---
# Current desk (2026-09-05): instance-20260831-171822 → 35.253.21.246
# Live UI:     https://35.253.21.246/live
# Backtest UI: https://35.253.21.246/
# Login:       ali / 123451
ASIM_LAB_URL=https://35.253.21.246
ASIM_LAB_INSECURE=1

# --- REQUIRED: auto-update bundle from the same desk ---
BRIDGE_UPDATE_URL=https://35.253.21.246/bridge/onyxion-bridge-bundle.zip
BRIDGE_PROFILE=ali

# --- Sanity check (must match ASIM_MT5_LOGIN) ---
EXPECTED_MT5_LOGIN=472640728
EXPECTED_MT5_SYMBOL=XAUUSDm

# --- Ali X-Trend source = KJ GagaTrend (Hamza used SuperTrend; do NOT change for Ali) ---
XTREND_SOURCE=gaga
XTREND_GATE=1
XTREND_BUF=0
# SUPP X-Trend gate is separate (default OFF = wick break of last trade candle only)
XTREND_GATE_SUPP=0

# --- Live filters (match GCP desk) — MUST stay OFF for Ali ---
SKIP_WORST_HOURS=0
FOCUS_BEST_HOURS=0
SKIP_WEEKENDS=0

# Bridge stamps every heartbeat with UTC bar/tick/server times (time_tz=UTC)
# so MT5 M15 bar opens and the live dashboard chart axis stay aligned.

# --- Engine tuning (match Google Console Deployment/env.instance-20260831-171822) ---
VOLUME=0.02
# --- Strategy selected by walk-forward test (Feb-May optimise, Jun-Aug blind) ---
# Primary gate (body-break AND X-Trend clear) on EVERY green/red candle; each
# pass opens its own ticket, stacking in the run direction to MAXPOS. No
# supplementary wick logic (MAX_SUPP=0). Amber still flattens.
ENTRY_EVERY_CANDLE=1
HIST_THRESH=15
# Stop = 1.25 x Wilder ATR(14) of raw M15 at entry, fixed per trade. The RATIO
# to volatility is what held out-of-sample, not any fixed dollar distance.
TSL_ATR_MULT=1.25
# Fallback fixed stop (ticks x tick size) when TSL_ATR_MULT=0 or ATR not warmed.
TSL_TICKS=1111
TSL_TICK_SIZE=0.001
# TSL_PTS no longer sizes the stop; entry-fill logic only.
TSL_PTS=11.02
STOP_SLIPPAGE_PTS=0
SPREAD_COST=0.06
TRAIL_EVERY_CANDLE=1
# Trail stop to entry-bar close (ON). Defer still skips stop-TEST on entry bar.
# OFF reproduces the uniform -0.56 stop-outs — leave ON unless A/B testing.
TRAIL_ENTRY_BAR=1
DISABLE_STOP_LOSS=0
ENTRY_BAR_MODE=defer
PRIMARY_WICK_GATE=0
MAXPOS=20
MAX_SUPP=0
LEVERAGE=100
BEST_LOT_MULT=2.0
START_BALANCE=500

# Optional:
# MT5_POLL_SECONDS=2
# MT5_MAGIC_ASIM=126823
# ASIM_MT5_LOT=0.01
