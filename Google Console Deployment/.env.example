# Copy to /opt/asim-gcp/.env on each VM (deploy uses env.<instance> files).
MODEL_NAME=Asim GCP Live
PORT=8080
BEHIND_HTTPS=1
STATE_FILE=/opt/asim-gcp/data/engine_state.json
GCP_STORE_DIR=/opt/asim-gcp/data

# Login (per-instance: hamza on hamzatestserver01, ali on instance-20260831-171822)
AUTH_USER=admin
AUTH_PASS=changeme
AUTH_SECRET=
AUTH_SESSION_HOURS=24
AUTH_REMEMBER_DAYS=30
# Exness MT5 target (bridge sends heartbeats here)
EXPECTED_MT5_LOGIN=472640728
EXPECTED_MT5_SYMBOL=XAUUSDm

# Old Asim AWS histogram profile (simple gold backtest reference, filters OFF)
VOLUME=0.01
HIST_THRESH=10
TSL_PTS=11.02
STOP_SLIPPAGE_PTS=0
SPREAD_COST=0.06
TRAIL_EVERY_CANDLE=1
DISABLE_STOP_LOSS=0
ENTRY_BAR_MODE=off
XTREND_GATE=1
XTREND_BUF=0
PRIMARY_WICK_GATE=0
SKIP_WORST_HOURS=0
FOCUS_BEST_HOURS=0
BEST_LOT_MULT=2.0
SKIP_WEEKENDS=0
MAXPOS=20
MAX_SUPP=10
LEVERAGE=100
START_BALANCE=500

# Point local bridge at this host after deploy, e.g.
# ASIM_LAB_URL=http://35.232.76.12:8080
